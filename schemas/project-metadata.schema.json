{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadream.local/schemas/project-metadata.schema.json",
  "title": "ProjectMetadata",
  "description": "Project-level metadata for plan-set generation and title blocks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "client_name",
    "site_address",
    "ac_system_size",
    "dc_system_size"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "project-metadata-v1"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "client_name": {
      "type": "string",
      "minLength": 1
    },
    "site_address": {
      "type": "string",
      "minLength": 1
    },
    "ac_system_size": {
      "type": "string",
      "minLength": 1
    },
    "dc_system_size": {
      "type": "string",
      "minLength": 1
    },
    "customer_contact": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_website": {
      "type": "string"
    },
    "ahj": {
      "type": "string"
    },
    "designer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company": { "type": "string" },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "phone": { "type": "string" },
        "contact": { "type": "string" }
      }
    },
    "sheet_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": { "type": "string" },
        "drawn_by": { "type": "string" },
        "checked_by": { "type": "string" },
        "approved_by": { "type": "string" },
        "issue_date": { "type": "string", "format": "date" },
        "revision": { "type": "string" }
      }
    }
  }
}
